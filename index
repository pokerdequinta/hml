<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Poker de Quinta - Gerenciador de Torneio</title>
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');

        :root {
            --bg: #0d1b14;
            --panel: rgba(21, 40, 30, 0.92);
            --panel2: #1c3326;
            --gold: #d4a843;
            --gold2: #c99730;
            --gold-light: #f0d78c;
            --text: #e0dcd0;
            --text2: #b8b09a;
            --danger: #c0392b;
            --success: #27ae60;
            --info: #2980b9;
            --border: #2a4032;
            --font: 'Segoe UI', system-ui, -apple-system, sans-serif;
            --radius: 10px;
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #0a1510;
            color: var(--text);
            font-family: var(--font);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow-x: hidden;
        }

        /* Fundo com cartas e fichas */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(ellipse at 20% 50%, rgba(212, 168, 67, 0.08) 0%, transparent 50%),
                radial-gradient(ellipse at 80% 50%, rgba(212, 168, 67, 0.06) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 100%, rgba(39, 174, 96, 0.05) 0%, transparent 40%),
                radial-gradient(ellipse at 50% 0%, rgba(41, 128, 185, 0.05) 0%, transparent 40%),
                linear-gradient(135deg, #0a1510 0%, #1a3022 30%, #0d1b14 60%, #1a2e1f 100%);
            z-index: -2;
        }

        body::after {
            content: '♠♥♦♣🃏♠♥♦♣🃏♠♥♦♣🃏';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            font-size: 80px;
            color: rgba(212, 168, 67, 0.04);
            display: flex;
            flex-wrap: wrap;
            justify-content: space-around;
            align-content: space-around;
            letter-spacing: 40px;
            word-spacing: 60px;
            z-index: -1;
            pointer-events: none;
            line-height: 1.8;
            opacity: 0.5;
        }

        .chip-pattern {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            pointer-events: none;
            opacity: 0.06;
            background-image: 
                radial-gradient(circle at 10% 20%, var(--gold) 1px, transparent 1px),
                radial-gradient(circle at 30% 60%, var(--gold) 1px, transparent 1px),
                radial-gradient(circle at 50% 10%, var(--gold) 1px, transparent 1px),
                radial-gradient(circle at 70% 70%, var(--gold) 1px, transparent 1px),
                radial-gradient(circle at 90% 30%, var(--gold) 1px, transparent 1px),
                radial-gradient(circle at 45% 85%, var(--gold) 1px, transparent 1px);
            background-size: 150px 150px;
            background-repeat: repeat;
        }

        /* Modo Projeção */
        body.projection-mode {
            background: #0a1510 !important;
            align-items: center;
            justify-content: center;
        }
        body.projection-mode::before {
            background: 
                radial-gradient(ellipse at 20% 50%, rgba(212, 168, 67, 0.15) 0%, transparent 60%),
                radial-gradient(ellipse at 80% 50%, rgba(212, 168, 67, 0.10) 0%, transparent 60%),
                radial-gradient(ellipse at 50% 100%, rgba(39, 174, 96, 0.08) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 0%, rgba(41, 128, 185, 0.08) 0%, transparent 50%),
                linear-gradient(135deg, #0a1510 0%, #1a3022 40%, #0d1b14 60%, #1a2e1f 100%);
            z-index: -2;
        }
        body.projection-mode::after {
            content: '♠♥♦♣🃏♠♥♦♣🃏♠♥♦♣🃏♠♥♦♣🃏♠♥♦♣🃏♠♥♦♣🃏♠♥♦♣🃏♠♥♦♣🃏';
            font-size: 100px;
            color: rgba(212, 168, 67, 0.06);
            opacity: 0.8;
        }
        body.projection-mode .chip-pattern {
            opacity: 0.10;
        }
        body.projection-mode #mainHeader,
        body.projection-mode #tabNav,
        body.projection-mode .no-project {
            display: none !important;
        }
        body.projection-mode #panel-dashboard {
            max-width: 98vw;
            width: 100%;
            padding: 1rem 2rem;
            background: rgba(0,0,0,0.7);
            border-radius: 20px;
            border: 2px solid rgba(212, 168, 67, 0.3);
            box-shadow: 0 0 60px rgba(212, 168, 67, 0.1);
            backdrop-filter: blur(10px);
        }
        body.projection-mode #panel-dashboard .card {
            background: rgba(21, 40, 30, 0.5);
            border: 1px solid rgba(212, 168, 67, 0.2);
        }
        body.projection-mode .timer-display {
            font-size: 10em !important;
            font-family: 'Orbitron', monospace !important;
            background: rgba(0,0,0,0.5);
            border: 2px solid rgba(212, 168, 67, 0.3);
        }
        body.projection-mode .blind-info span {
            font-size: 2em;
            padding: 12px 30px;
        }
        body.projection-mode .stat-value {
            font-size: 3em !important;
        }
        body.projection-mode .king-display {
            padding: 25px;
            border-width: 3px;
        }
        body.projection-mode .king-avatar {
            width: 120px;
            height: 120px;
            font-size: 4em;
        }
        body.projection-mode .king-info .king-name {
            font-size: 2.5em;
        }
        body.projection-mode .king-info .king-hand {
            font-size: 1.5em;
        }
        body.projection-mode .stat-box {
            padding: 25px;
            background: rgba(28, 51, 38, 0.7);
        }
        body.projection-mode .timer-level {
            font-size: 2em;
        }
        body.projection-mode .prize-sidebar {
            display: none;
        }

        header {
            background: linear-gradient(180deg, rgba(26, 46, 31, 0.95) 0%, rgba(15, 31, 21, 0.95) 100%);
            border-bottom: 2px solid var(--gold);
            padding: 12px 24px;
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            box-shadow: 0 2px 15px rgba(0,0,0,0.5);
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(10px);
        }
        .logo-area { display: flex; align-items: center; gap: 10px; }
        .logo-icon { font-size: 40px; filter: drop-shadow(0 0 8px var(--gold)); }
        .logo-text {
            font-size: 1.4em;
            font-weight: 800;
            letter-spacing: 1px;
            color: var(--gold);
            text-shadow: 0 0 20px rgba(212,168,67,0.5);
            line-height: 1.2;
        }
        .logo-text small {
            display: block;
            font-size: 0.5em;
            font-weight: 400;
            letter-spacing: 3px;
            color: var(--gold-light);
        }

        nav.tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            background: rgba(21, 40, 30, 0.9);
            border-radius: 25px;
            padding: 4px;
            margin: 10px 16px;
            box-shadow: var(--shadow);
            overflow-x: auto;
            position: sticky;
            top: 80px;
            z-index: 99;
            backdrop-filter: blur(10px);
        }
        nav.tabs button {
            background: transparent;
            border: none;
            color: var(--text2);
            padding: 10px 16px;
            border-radius: 22px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.85em;
            white-space: nowrap;
            transition: all 0.25s;
            font-family: var(--font);
        }
        nav.tabs button:hover { color: #fff; background: rgba(255,255,255,0.05); }
        nav.tabs button.active {
            background: var(--gold);
            color: #1a2e1f;
            font-weight: 700;
            box-shadow: 0 2px 12px rgba(212,168,67,0.5);
        }

        main {
            flex: 1;
            padding: 10px 16px 30px;
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
            position: relative;
            z-index: 1;
        }
        .tab-panel { display: none; animation: fadeIn 0.3s ease; }
        .tab-panel.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

        .card {
            background: var(--panel);
            border-radius: var(--radius);
            padding: 20px;
            margin-bottom: 16px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            backdrop-filter: blur(5px);
        }
        .card h3 {
            color: var(--gold);
            margin-bottom: 12px;
            font-size: 1.1em;
            display: flex;
            align-items: center;
            gap: 8px;
            border-bottom: 1px solid var(--border);
            padding-bottom: 10px;
        }
        .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
        .grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
        .grid4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }

        .stat-box {
            background: var(--panel2);
            border-radius: var(--radius);
            padding: 16px;
            text-align: center;
            border: 1px solid var(--border);
            position: relative;
        }
        .stat-box .stat-value { font-size: 2.2em; font-weight: 800; color: var(--gold); line-height: 1; }
        .stat-box .stat-label { font-size: 0.8em; color: var(--text2); margin-top: 4px; text-transform: uppercase; letter-spacing: 1px; }
        .stat-box.highlight { border-color: var(--gold); box-shadow: 0 0 20px rgba(212,168,67,0.2); }
        .stat-box .stat-icon {
            position: absolute;
            top: 8px;
            left: 8px;
            font-size: 1.2em;
            opacity: 0.5;
        }

        .timer-container {
            text-align: center;
            padding: 10px;
        }
        .timer-level {
            font-size: 1.2em;
            color: var(--gold-light);
            margin-bottom: 5px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        .timer-display {
            font-size: 6em;
            font-weight: 900;
            text-align: center;
            color: #fff;
            font-variant-numeric: tabular-nums;
            font-family: 'Orbitron', 'Courier New', monospace !important;
            letter-spacing: 4px;
            text-shadow: 0 0 40px rgba(212, 168, 67, 0.3), 0 0 80px rgba(212, 168, 67, 0.1);
            padding: 15px 0;
            background: rgba(0,0,0,0.3);
            border-radius: 15px;
            border: 1px solid rgba(212, 168, 67, 0.2);
            margin: 10px 0;
        }
        .timer-display.warning { color: #f39c12; text-shadow: 0 0 40px rgba(243, 156, 18, 0.4); }
        .timer-display.danger { color: #e74c3c; text-shadow: 0 0 40px rgba(231, 76, 60, 0.4); animation: pulse 0.5s infinite; }
        .timer-display.break { color: #3498db; text-shadow: 0 0 40px rgba(52, 152, 219, 0.4); }
        @keyframes pulse { 0%,100% { opacity:1; } 50% { opacity:0.5; } }

        .timer-break-info {
            font-size: 0.9em;
            color: var(--text2);
            margin-top: 5px;
        }
        .timer-break-info strong {
            color: var(--gold);
        }

        .blind-info {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
            font-size: 1.2em;
        }
        .blind-info span { 
            background: rgba(28, 51, 38, 0.8);
            padding: 8px 20px;
            border-radius: 20px;
            font-weight: 700;
            backdrop-filter: blur(5px);
        }
        .blind-info .sb { color: #5dade2; }
        .blind-info .bb { color: #f0d78c; }
        .blind-info .ante { color: #e74c3c; }

        .king-display {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 15px;
            background: rgba(212, 168, 67, 0.1);
            border-radius: 15px;
            border: 2px solid var(--gold);
            margin: 10px 0;
        }
        .king-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            border: 3px solid var(--gold);
            object-fit: cover;
            background: var(--panel2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5em;
            flex-shrink: 0;
        }
        .king-info {
            flex: 1;
        }
        .king-info .king-title {
            font-size: 0.8em;
            color: var(--gold-light);
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .king-info .king-name {
            font-size: 1.8em;
            font-weight: 700;
            color: var(--gold);
        }
        .king-info .king-hand {
            font-size: 1.1em;
            color: var(--text2);
            margin-top: 4px;
        }
        .king-info .king-hand strong {
            color: var(--gold-light);
        }

        table { width: 100%; border-collapse: collapse; font-size: 0.9em; }
        th, td { padding: 10px 12px; border-bottom: 1px solid var(--border); text-align: left; }
        th { background: var(--panel2); color: var(--gold); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; font-size: 0.8em; }
        tr:hover td { background: rgba(255,255,255,0.02); }
        .table-wrap { overflow-x: auto; }
        .rank-1 { color: var(--gold); font-weight: 900; }
        .rank-2 { color: #c0c0c0; font-weight: 700; }
        .rank-3 { color: #cd7f32; font-weight: 700; }

        button.btn {
            background: var(--gold);
            color: #1a2e1f;
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            cursor: pointer;
            font-weight: 700;
            font-size: 0.9em;
            transition: all 0.2s;
            font-family: var(--font);
            letter-spacing: 0.5px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        button.btn:hover { background: var(--gold2); box-shadow: 0 4px 15px rgba(212,168,67,0.4); transform: translateY(-1px); }
        button.btn.small { padding: 6px 14px; font-size: 0.8em; border-radius: 18px; }
        button.btn.danger { background: var(--danger); color: #fff; }
        button.btn.danger:hover { background: #a93226; }
        button.btn.info { background: var(--info); color: #fff; }
        button.btn.success { background: var(--success); color: #fff; }
        button.btn.outline { background: transparent; border: 2px solid var(--gold); color: var(--gold); }
        button.btn.outline:hover { background: var(--gold); color: #1a2e1f; }

        input[type="text"], input[type="number"], input[type="time"], select {
            background: var(--panel2);
            border: 1px solid var(--border);
            color: var(--text);
            padding: 10px 14px;
            border-radius: 20px;
            font-family: var(--font);
            font-size: 0.9em;
            width: 100%;
            transition: border 0.2s;
        }
        input:focus, select:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 8px rgba(212,168,67,0.3); }
        label { display: block; font-size: 0.8em; color: var(--text2); margin-bottom: 4px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
        .form-group { margin-bottom: 12px; }
        .form-row { display: flex; gap: 10px; flex-wrap: wrap; }
        .form-row>* { flex: 1; min-width: 100px; }

        .input-with-icon {
            position: relative;
        }
        .input-with-icon .input-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 1.1em;
            opacity: 0.6;
            pointer-events: none;
        }
        .input-with-icon input,
        .input-with-icon select {
            padding-left: 36px;
        }

        .modal-overlay { display: none; position: fixed; top:0; left:0; width:100%; height:100%; background: rgba(0,0,0,0.85); z-index:200; justify-content:center; align-items:center; backdrop-filter: blur(5px); }
        .modal-overlay.show { display: flex; }
        .modal { background: var(--panel); border-radius: var(--radius); padding: 24px; max-width: 600px; width:90%; max-height:85vh; overflow-y:auto; border:2px solid var(--gold); box-shadow:0 0 40px rgba(0,0,0,0.7); }
        .modal h3 { color: var(--gold); margin-bottom:16px; }
        .modal-close { float:right; background:none; border:none; color:#fff; font-size:1.5em; cursor:pointer; }

        .badge { display:inline-block; padding:4px 10px; border-radius:12px; font-size:0.75em; font-weight:700; letter-spacing:0.5px; }
        .badge.gold { background:var(--gold); color:#1a2e1f; }
        .badge.red { background:var(--danger); color:#fff; }
        .badge.green { background:var(--success); color:#fff; }
        .badge.blue { background:var(--info); color:#fff; }

        .projection-btn {
            background: #2c3e50;
            border: 2px solid var(--gold);
            color: var(--gold);
            padding: 8px 18px;
            border-radius: 25px;
            cursor: pointer;
            font-weight: 700;
            font-size: 0.9em;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .projection-btn:hover { background: var(--gold); color: #1a2e1f; }

        .prize-sidebar {
            position: fixed;
            right: 0;
            top: 120px;
            width: 220px;
            background: rgba(21, 40, 30, 0.95);
            border-left: 2px solid var(--gold);
            border-radius: 10px 0 0 10px;
            padding: 15px;
            box-shadow: -5px 0 30px rgba(0,0,0,0.5);
            backdrop-filter: blur(10px);
            z-index: 50;
            transition: transform 0.3s ease;
        }
        .prize-sidebar h4 {
            color: var(--gold);
            text-align: center;
            font-size: 0.9em;
            margin-bottom: 10px;
            border-bottom: 1px solid var(--border);
            padding-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .prize-item {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            font-size: 0.85em;
        }
        .prize-item .place {
            color: var(--gold);
            font-weight: 700;
        }
        .prize-item .amount {
            color: var(--gold-light);
            font-weight: 600;
        }
        .prize-item:last-child { border-bottom: none; }

        @media (max-width: 768px) {
            .prize-sidebar {
                display: none;
            }
        }

        .toast {
            position:fixed;
            bottom:20px;
            right:20px;
            background:var(--gold);
            color:#1a2e1f;
            padding:12px 20px;
            border-radius:25px;
            font-weight:700;
            z-index:300;
            animation:slideUp 0.4s ease;
            box-shadow:0 6px 20px rgba(0,0,0,0.4);
        }
        @keyframes slideUp { from{transform:translateY(60px);opacity:0;} to{transform:translateY(0);opacity:1;} }

        .ranking-list {
            display: grid;
            gap: 8px;
            margin-top: 10px;
        }
        .ranking-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 12px;
            background: var(--panel2);
            border-radius: 8px;
            border-left: 3px solid var(--border);
        }
        .ranking-item .rank {
            font-weight: 700;
            min-width: 30px;
            font-size: 1.1em;
        }
        .ranking-item .rank.gold { color: var(--gold); }
        .ranking-item .rank.silver { color: #c0c0c0; }
        .ranking-item .rank.bronze { color: #cd7f32; }
        .ranking-item .name { flex: 1; }
        .ranking-item .stack { color: var(--gold-light); font-weight: 600; }

        .rebuy-box, .addon-box {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.75em;
            font-weight: 700;
            margin: 0 2px;
        }
        .rebuy-box { background: var(--info); color: #fff; }
        .addon-box { background: var(--success); color: #fff; }
    </style>
</head>
<body>
    <div class="chip-pattern"></div>

    <header id="mainHeader">
        <div class="logo-area">
            <span class="logo-icon">♠️🃏</span>
            <div class="logo-text">POKER DE QUINTA<small>Home Game League</small></div>
        </div>
        <div style="flex:1;text-align:right;font-size:0.85em;color:var(--text2);">
            <span id="headerInfo">Torneio não iniciado</span>
        </div>
        <button class="projection-btn no-print" onclick="app.openDashboardWindow()" title="Abrir painel de blinds em janela separada para projeção">
            📺 Projetar na TV
        </button>
    </header>

    <nav class="tabs no-print" id="tabNav">
        <button data-tab="dashboard" class="active">⏱️ Dashboard</button>
        <button data-tab="blinds">📋 Estrutura Blinds</button>
        <button data-tab="premios">🏆 Premiações</button>
        <button data-tab="jogadores">👥 Jogadores</button>
        <button data-tab="ranking">📊 Ranking</button>
        <button data-tab="king">👑 Rei da Mesa</button>
        <button data-tab="dealer">📒 Dealer</button>
        <button data-tab="sorteio">🎲 Sorteio Mesas</button>
        <button data-tab="pagamentos">💸 PIX</button>
    </nav>

    <!-- Sidebar de Premiações -->
    <div class="prize-sidebar" id="prizeSidebar">
        <h4>🏆 Premiação</h4>
        <div id="prizeList">
            <div class="prize-item"><span class="place">🥇 1º Colocado</span><span class="amount">R$ 0,00</span></div>
            <div class="prize-item"><span class="place">🥈 2º Colocado</span><span class="amount">R$ 0,00</span></div>
            <div class="prize-item"><span class="place">🥉 3º Colocado</span><span class="amount">R$ 0,00</span></div>
            <div class="prize-item"><span class="place">4º Colocado</span><span class="amount">R$ 0,00</span></div>
