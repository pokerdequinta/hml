    <script>
        // ==================== CONFIGURAÇÃO FIREBASE ====================
        const firebaseConfig = {
            apiKey: "AIzaSyD6vZ9nPxZxXxXxXxXxXxXxXxXxXxXxXxXx",
            authDomain: "pokerquinta.firebaseapp.com",
            databaseURL: "https://pokerquinta-default-rtdb.firebaseio.com",
            projectId: "pokerquinta",
            storageBucket: "pokerquinta.firebasestorage.app",
            messagingSenderId: "123456789012",
            appId: "1:123456789012:web:abcdef1234567890abcdef"
        };

        try {
            firebase.initializeApp(firebaseConfig);
            console.log('Firebase inicializado com sucesso!');
        } catch (error) {
            console.warn('Erro ao inicializar Firebase:', error);
        }
        const db = firebase.database();

        // ==================== APP PRINCIPAL ====================
        const app = {
            players: [],
            blindStructure: [],
            prizes: [],
            tables: [],
            eliminatedPlayers: [],
            rebuyCount: 0,
            addonCount: 0,
            buyinCount: 0,
            config: {
                buyinValue: 50.00,
                rebuyValue: 50.00,
                addonValue: 25.00,
                stackInicial: 10000,
                stackRebuy: 10000,
                stackAddon: 5000,
                orgPixKey: '',
                orgPixName: 'Poker de Quinta',
                orgPixCity: 'Sao Paulo',
            },
            timerInterval: null,
            currentLevelIndex: 0,
            timeRemaining: 0,
            isRunning: false,
            isBreak: false,
            isDashboardWindow: false,
            dealerPlayerId: null,
            kingPlayerId: null,
            kingHand: '',
            breakTimer: 150,

            init() {
                const urlParams = new URLSearchParams(window.location.search);
                this.isDashboardWindow = urlParams.get('dashboard') === '1';

                if (this.isDashboardWindow) {
                    this.setupDashboardWindow();
                    return;
                }

                this.loadAllData();
                this.setupTabNavigation();
                this.renderAll();
                this.updateDashboard();
                this.updatePrizeSidebar();
                this.populateDealerSelects();
                this.populateKingSelect();
                this.populatePixSelects();
                const savedConfig = localStorage.getItem('pokerConfig');
                if (savedConfig) {
                    const c = JSON.parse(savedConfig);
                    this.config = { ...this.config, ...c };
                }
                document.getElementById('pixOrgKey').value = this.config.orgPixKey;
                document.getElementById('pixOrgName').value = this.config.orgPixName;
                document.getElementById('pixOrgCity').value = this.config.orgPixCity;
                this.updateHeaderInfo();
                if (this.isRunning && this.timeRemaining > 0) {
                    this.runTimer();
                }
                this.updateTimerDisplay();
                this.updateKingDisplay();
                this.startBreakTimer();

                this.syncWithFirebase();
            },

            setupDashboardWindow() {
                document.body.classList.add('projection-mode');
                // Esconde todos os controles
                document.querySelectorAll('.no-project').forEach(el => el.style.display = 'none');
                document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
                document.getElementById('panel-dashboard').classList.add('active');
                
                // Ajusta o dashboard para projeção
                const dashboard = document.getElementById('panel-dashboard');
                dashboard.style.maxWidth = '98vw';
                dashboard.style.width = '100%';
                dashboard.style.padding = '1rem 2rem';
                
                this.loadAllData();
                this.updateDashboard();
                this.updatePrizeSidebar();
                this.updateKingDisplay();
                this.updateTimerDisplay();

                // Sincronização
                window.addEventListener('storage', (e) => {
                    if (e.key && e.key.startsWith('poker')) {
                        this.loadAllData();
                        this.updateDashboard();
                        this.updatePrizeSidebar();
                        this.updateKingDisplay();
                        this.updateTimerDisplay();
                    }
                });

                setInterval(() => {
                    this.loadAllData();
                    this.updateDashboard();
                    this.updatePrizeSidebar();
                    this.updateKingDisplay();
                    this.updateTimerDisplay();
                }, 1000);
            },

            openDashboardWindow() {
                const url = window.location.origin + window.location.pathname + '?dashboard=1';
                window.open(url, 'pokerDashboard', 'width=1400,height=900,menubar=no,toolbar=no,status=no,resizable=yes');
            },

            // === FIREBASE ===
            syncWithFirebase() {
                const stateRef = db.ref('pokerState');
                stateRef.on('value', (snapshot) => {
                    const data = snapshot.val();
                    if (data) {
                        this.players = data.players || [];
                        this.blindStructure = data.blindStructure || [];
                        this.prizes = data.prizes || [];
                        this.eliminatedPlayers = data.eliminatedPlayers || [];
                        this.rebuyCount = data.rebuyCount || 0;
                        this.addonCount = data.addonCount || 0;
                        this.buyinCount = data.buyinCount || 0;
                        this.currentLevelIndex = data.currentLevelIndex || 0;
                        this.timeRemaining = data.timeRemaining || 0;
                        this.isRunning = data.isRunning || false;
                        this.isBreak = data.isBreak || false;
                        this.dealerPlayerId = data.dealerPlayerId || null;
                        this.kingPlayerId = data.kingPlayerId || null;
                        this.kingHand = data.kingHand || '';
                        this.tables = data.tables || [];
                        this.breakTimer = data.breakTimer || 150;

                        this.renderAll();
                        this.updateDashboard();
                        this.updatePrizeSidebar();
                        this.updateTimerDisplay();
                        this.updateHeaderInfo();
                        this.updateKingDisplay();
                        this.populateDealerSelects();
                        this.populateKingSelect();

                        if (this.isRunning && this.timeRemaining > 0) {
                            this.runTimer();
                        }
                    }
                });
            },

            saveToFirebase() {
                const state = {
                    players: this.players,
                    blindStructure: this.blindStructure,
                    prizes: this.prizes,
                    eliminatedPlayers: this.eliminatedPlayers,
                    rebuyCount: this.rebuyCount,
                    addonCount: this.addonCount,
                    buyinCount: this.buyinCount,
                    currentLevelIndex: this.currentLevelIndex,
                    timeRemaining: this.timeRemaining,
                    isRunning: this.isRunning,
                    isBreak: this.isBreak,
                    dealerPlayerId: this.dealerPlayerId,
                    kingPlayerId: this.kingPlayerId,
                    kingHand: this.kingHand,
                    tables: this.tables,
                    breakTimer: this.breakTimer,
                    timestamp: firebase.database.ServerValue.TIMESTAMP
                };

                try {
                    db.ref('pokerState').set(state);
                    this.saveAllData();
                } catch (error) {
                    console.warn('Erro ao salvar no Firebase:', error);
                    this.saveAllData();
                }
            },

            saveAllData() {
                const data = {
                    players: this.players,
                    blindStructure: this.blindStructure,
                    prizes: this.prizes,
                    eliminatedPlayers: this.eliminatedPlayers,
                    rebuyCount: this.rebuyCount,
                    addonCount: this.addonCount,
                    buyinCount: this.buyinCount,
                    currentLevelIndex: this.currentLevelIndex,
                    timeRemaining: this.timeRemaining,
                    isRunning: this.isRunning,
                    isBreak: this.isBreak,
                    dealerPlayerId: this.dealerPlayerId,
                    kingPlayerId: this.kingPlayerId,
                    kingHand: this.kingHand,
                    tables: this.tables,
                    breakTimer: this.breakTimer,
                };
                localStorage.setItem('pokerData', JSON.stringify(data));
                this.saveToFirebase();
            },

            loadAllData() {
                const data = localStorage.getItem('pokerData');
                if (data) {
                    try {
                        const parsed = JSON.parse(data);
                        this.players = parsed.players || [];
                        this.blindStructure = parsed.blindStructure || [];
                        this.prizes = parsed.prizes || [];
                        this.eliminatedPlayers = parsed.eliminatedPlayers || [];
                        this.rebuyCount = parsed.rebuyCount || 0;
                        this.addonCount = parsed.addonCount || 0;
                        this.buyinCount = parsed.buyinCount || 0;
                        this.currentLevelIndex = parsed.currentLevelIndex || 0;
                        this.timeRemaining = parsed.timeRemaining || 0;
                        this.isRunning = parsed.isRunning || false;
                        this.isBreak = parsed.isBreak || false;
                        this.dealerPlayerId = parsed.dealerPlayerId || null;
                        this.kingPlayerId = parsed.kingPlayerId || null;
                        this.kingHand = parsed.kingHand || '';
                        this.tables = parsed.tables || [];
                        this.breakTimer = parsed.breakTimer || 150;
                    } catch (e) {
                        console.warn('Erro ao carregar dados do localStorage:', e);
                    }
                }
            },

            setupTabNavigation() {
                const buttons = document.querySelectorAll('#tabNav button');
                buttons.forEach(btn => {
                    btn.addEventListener('click', () => {
                        buttons.forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');
                        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
                        const panel = document.getElementById('panel-' + btn.dataset.tab);
                        if (panel) panel.classList.add('active');
                    });
                });
            },

            renderAll() {
                this.renderBlinds();
                this.renderPrizes();
                this.renderPlayers();
                this.renderDealer();
                this.renderTables();
                this.renderRanking();
            },

            renderBlinds() {
                const tbody = document.getElementById('blindTableBody');
                tbody.innerHTML = '';
                this.blindStructure.forEach((b, i) => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>${i+1}</td>
                        <td>${b.sb}</td>
                        <td>${b.bb}</td>
                        <td>${b.ante || 0}</td>
                        <td>${b.duration}min</td>
                        <td><button class="btn danger small" onclick="app.removeBlind(${i})">✕</button></td>
                    `;
                    tbody.appendChild(tr);
                });
            },

            renderPrizes() {
                const tbody = document.getElementById('prizeTableBody');
                tbody.innerHTML = '';
                let total = 0;
                this.prizes.forEach((p, i) => {
                    total += p.value;
                    const tr = document.createElement('tr');
                    const emoji = p.position === 1 ? '🥇' : p.position === 2 ? '🥈' : p.position === 3 ? '🥉' : '';
                    tr.innerHTML = `
                        <td>${emoji} ${p.position}º Colocado</td>
                        <td>R$ ${p.value.toFixed(2)}</td>
                        <td><button class="btn danger small" onclick="app.removePrize(${i})">✕</button></td>
                    `;
                    tbody.appendChild(tr);
                });
                document.getElementById('prizeTotal').textContent = total.toFixed(2);
                this.updatePrizeSidebar();
            },

            renderPlayers() {
                const tbody = document.getElementById('playerTableBody');
                tbody.innerHTML = '';
                this.players.forEach((p, i) => {
                    const isEliminated = this.eliminatedPlayers.includes(p.id);
                    const tr = document.createElement('tr');
                    tr.style.opacity = isEliminated ? '0.5' : '1';
                    tr.innerHTML = `
                        <td>${i+1}</td>
                        <td>${p.name}</td>
                        <td>${p.stack}</td>
                        <td>${p.buyin || 1}</td>
                        <td><span class="rebuy-box">${p.rebuy || 0}</span></td>
                        <td><span class="addon-box">${p.addon || 0}</span></td>
                        <td>${isEliminated ? '✅' : '❌'}</td>
                        <td>
                            <button class="btn small outline" onclick="app.editPlayer(${i})">✏️</button>
                            <button class="btn small danger" onclick="app.removePlayer(${i})">🗑️</button>
                            ${isEliminated ? `<button class="btn small success" onclick="app.restorePlayer(${i})">↩️</button>` : 
                                              `<button class="btn small danger" onclick="app.eliminatePlayer(${i})">💀</button>`}
                            <button class="btn small info" onclick="app.rebuyPlayer(${i})">🔄</button>
                            <button class="btn small success" onclick="app.addonPlayer(${i})">➕</button>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
                this.updateDashboard();
                this.renderRanking();
            },

            renderRanking() {
                const container = document.getElementById('rankingList');
                container.innerHTML = '';
                const active = this.players.filter(p => !this.eliminatedPlayers.includes(p.id));
                const sorted = [...active].sort((a, b) => b.stack - a.stack);
                
                if (sorted.length === 0) {
                    container.innerHTML = '<p style="color:var(--text2);text-align:center;">Nenhum jogador inscrito.</p>';
                    return;
                }

                sorted.forEach((p, i) => {
                    const div = document.createElement('div');
                    div.className = 'ranking-item';
                    const rank = i + 1;
                    let rankClass = '';
                    let rankEmoji = '';
                    if (rank === 1) { rankClass = 'gold'; rankEmoji = '🥇'; }
                    else if (rank === 2) { rankClass = 'silver'; rankEmoji = '🥈'; }
                    else if (rank === 3) { rankClass = 'bronze'; rankEmoji = '🥉'; }
                    
                    div.innerHTML = `
                        <span class="rank ${rankClass}">${rankEmoji} ${rank}º</span>
                        <span class="name">${p.name}</span>
                        <span class="stack">🪙 ${p.stack.toLocaleString()}</span>
                    `;
                    container.appendChild(div);
                });
            },

            renderDealer() {
                const tbody = document.getElementById('dealerTableBody');
                tbody.innerHTML = '';
                this.players.forEach(p => {
                    const tr = document.createElement('tr');
                    const isDealer = this.dealerPlayerId === p.id;
                    tr.innerHTML = `
                        <td>${p.name}</td>
                        <td>${p.table || '-'}</td>
                        <td>${p.position || '-'}</td>
                        <td>${isDealer ? '🃏 Dealer' : '-'}</td>
                    `;
                    tbody.appendChild(tr);
                });
            },

            renderTables() {
                const container = document.getElementById('tablesDisplay');
                container.innerHTML = '';
                if (!this.tables.length) {
                    container.innerHTML = '<p style="color:var(--text2);">Nenhuma mesa sorteada ainda.</p>';
                    return;
                }
                this.tables.forEach((table, idx) => {
                    const div = document.createElement('div');
                    div.className = 'card';
                    div.innerHTML = `
                        <h3>Mesa ${idx+1}</h3>
                        <div style="display:flex;flex-wrap:wrap;gap:8px;">
                            ${table.players.map(p => `<span class="badge gold">${p}</span>`).join('')}
                        </div>
                    `;
                    container.appendChild(div);
                });
            },

            updateDashboard() {
                const active = this.players.filter(p => !this.eliminatedPlayers.includes(p.id));
                const totalStack = active.reduce((sum, p) => sum + p.stack, 0);
                const avg = active.length ? Math.round(totalStack / active.length) : 0;

                document.getElementById('dashPot').textContent = `R$ ${(this.players.length * this.config.buyinValue).toFixed(2)}`;
                document.getElementById('dashPlayers').textContent = active.length;
                document.getElementById('dashAvg').textContent = avg;
                document.getElementById('dashTotalFichas').textContent = totalStack;
                document.getElementById('dashRebuys').textContent = this.rebuyCount;
                document.getElementById('dashAddons').textContent = this.addonCount;
                document.getElementById('dashElim').textContent = this.eliminatedPlayers.length;

                this.updateBlindInfo();
                this.updatePrizeSidebar();
                this.updateKingDisplay();
            },

            updateBlindInfo() {
                const level = this.blindStructure[this.currentLevelIndex];
                if (level) {
                    document.getElementById('sbVal').textContent = level.sb;
                    document.getElementById('bbVal').textContent = level.bb;
                    document.getElementById('anteVal').textContent = level.ante || 0;
                    document.getElementById('roundBadge').textContent = `Round ${this.currentLevelIndex+1}/${this.blindStructure.length}`;
                    document.getElementById('timerLevel').textContent = `Nível ${this.currentLevelIndex+1}`;
                }
                document.getElementById('breakBadge').style.display = this.isBreak ? 'inline' : 'none';
                if (this.isBreak) {
                    document.getElementById('breakBadge').textContent = '⏸ BREAK';
                }
                this.updateHeaderInfo();
            },

            updatePrizeSidebar() {
                const list = document.getElementById('prizeList');
                list.innerHTML = '';
                const sorted = [...this.prizes].sort((a,b) => a.position - b.position);
                sorted.slice(0, 5).forEach(p => {
                    const div = document.createElement('div');
                    div.className = 'prize-item';
                    const emoji = p.position === 1 ? '🥇' : p.position === 2 ? '🥈' : p.position === 3 ? '🥉' : '';
                    div.innerHTML = `<span class="place">${emoji} ${p.position}º Colocado</span><span class="amount">R$ ${p.value.toFixed(2)}</span>`;
                    list.appendChild(div);
                });
            },

            updateHeaderInfo() {
                const info = document.getElementById('headerInfo');
                const level = this.blindStructure[this.currentLevelIndex];
                if (level) {
                    info.textContent = `Nível ${this.currentLevelIndex+1} | SB ${level.sb} / BB ${level.bb}`;
                } else {
                    info.textContent = 'Torneio não iniciado';
                }
            },

            updateTimerDisplay() {
                const display = document.getElementById('timerDisplay');
                const mins = Math.floor(this.timeRemaining / 60);
                const secs = this.timeRemaining % 60;
                display.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;

                if (this.isBreak) {
                    display.className = 'timer-display break';
                } else if (this.timeRemaining <= 3 && this.timeRemaining > 0) {
                    display.className = 'timer-display danger';
                } else if (this.timeRemaining <= 60) {
                    display.className = 'timer-display warning';
                } else {
                    display.className = 'timer-display';
                }
            },

            updateBreakDisplay() {
                const mins = Math.floor(this.breakTimer / 60);
                const secs = this.breakTimer % 60;
                document.getElementById('breakCountdown').textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
            },

            startBreakTimer() {
                setInterval(() => {
                    if (this.isBreak && this.breakTimer > 0) {
                        this.breakTimer--;
                        this.updateBreakDisplay();
                        this.saveAllData();
                    }
                }, 1000);
            },

            startTimer() {
                if (this.isRunning) return;
                if (this.timeRemaining <= 0) {
                    const level = this.blindStructure[this.currentLevelIndex];
                    if (!level) { this.showToast('Nenhum nível configurado!'); return; }
                    this.timeRemaining = level.duration * 60;
                }
                this.isRunning = true;
                this.isBreak = false;
                this.runTimer();
                this.saveAllData();
                this.showToast('⏱️ Cronômetro iniciado!');
            },

            pauseTimer() {
                this.isRunning = false;
                clearInterval(this.timerInterval);
                this.saveAllData();
                this.showToast('⏸️ Cronômetro pausado');
            },

            resetTimer() {
                this.pauseTimer();
                this.currentLevelIndex = 0;
                const level = this.blindStructure[0];
                if (level) {
                    this.timeRemaining = level.duration * 60;
                } else {
                    this.timeRemaining = 0;
                }
                this.isBreak = false;
                this.updateTimerDisplay();
                this.updateDashboard();
                this.updateHeaderInfo();
                this.saveAllData();
                this.showToast('🔄 Cronômetro resetado');
            },

            nextLevel() {
                this.pauseTimer();
                if (this.isBreak) {
                    this.isBreak = false;
                    this.breakTimer = 150;
                    this.currentLevelIndex++;
                } else if (this.currentLevelIndex < this.blindStructure.length - 1) {
                    this.currentLevelIndex++;
                } else {
                    this.isBreak = true;
                    this.timeRemaining = 600;
                    this.breakTimer = 150;
                    this.updateTimerDisplay();
                    this.updateDashboard();
                    this.updateHeaderInfo();
                    this.saveAllData();
                    this.showToast('⏸️ Intervalo iniciado!');
                    if (this.isRunning) this.startTimer();
                    return;
                }

                const level = this.blindStructure[this.currentLevelIndex];
                if (level) {
                    this.timeRemaining = level.duration * 60;
                }
                this.breakTimer = 150;
                this.updateTimerDisplay();
                this.updateDashboard();
                this.updateHeaderInfo();
                this.saveAllData();

                if (this.isRunning) {
                    this.startTimer();
                }
                this.showToast(`⏭️ Avançado para Nível ${this.currentLevelIndex+1}`);
            },

            runTimer() {
                clearInterval(this.timerInterval);
                this.timerInterval = setInterval(() => {
                    if (!this.isRunning) return;
                    
                    if (this.timeRemaining > 0) {
                        this.timeRemaining--;
                        this.updateTimerDisplay();
                        this.saveAllData();
                        
                        if (this.timeRemaining === 60) {
                            this.playBeep(800, 0.2);
                            this.playBeep(1000, 0.2);
                        }
                        if (this.timeRemaining <= 3 && this.timeRemaining > 0) {
                            this.playBeep(1000, 0.15);
                        }
                    }
                    
                    if (this.timeRemaining <= 0 && this.isRunning) {
                        this.playBeep(1200, 0.5);
                        this.playBeep(1500, 0.5);
                        this.playBeep(1800, 0.8);
                        this.showToast('🔔 Fim do nível!');
                        this.nextLevel();
                    }
                }, 1000);
            },

            playBeep(freq, dur) {
                try {
                    const ctx = new (window.AudioContext || window.webkitAudioContext)();
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.frequency.value = freq;
                    osc.type = 'square';
                    gain.gain.value = 0.15;
                    osc.start();
                    setTimeout(() => {
                        osc.stop();
                        ctx.close();
                    }, dur * 1000);
                } catch(e) {}
            },

            populateKingSelect() {
                const select = document.getElementById('kingSelect');
                select.innerHTML = '<option value="">Selecione um jogador</option>';
                this.players.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.id;
                    opt.textContent = p.name;
                    select.appendChild(opt);
                });
            },

            setKing() {
                const select = document.getElementById('kingSelect');
                const id = select.value;
                const hand = document.getElementById('kingHandInput').value.trim();
                
                if (!id) { this.showToast('Selecione um jogador!'); return; }
                
                this.kingPlayerId = id;
                this.kingHand = hand || 'Mão não definida';
                this.updateKingDisplay();
                this.saveAllData();
                
                const player = this.players.find(p => p.id === id);
                this.showToast(`👑 ${player.name} é o Rei da Mesa!`);
            },

            updateKingDisplay() {
                const player = this.players.find(p => p.id === this.kingPlayerId);
                const nameEl = document.getElementById('kingName');
                const avatarEl = document.getElementById('kingAvatar');
                const handEl = document.getElementById('kingHand');
                const previewName = document.getElementById('kingPreviewName');
                const previewAvatar = document.getElementById('kingPreviewAvatar');
                const previewHand = document.getElementById('kingPreviewHand');

                if (player) {
                    const initial = player.name.charAt(0).toUpperCase();
                    nameEl.textContent = player.name;
                    avatarEl.textContent = initial;
                    previewName.textContent = player.name;
                    previewAvatar.textContent = initial;
                } else {
                    nameEl.textContent = 'Nenhum definido';
                    avatarEl.textContent = '👤';
                    previewName.textContent = 'Nenhum definido';
                    previewAvatar.textContent = '👤';
                }

                handEl.textContent = this.kingHand || '-';
                previewHand.textContent = this.kingHand || '-';
            },

            addBlindLevel() {
                const level = parseInt(document.getElementById('blindLevel').value) || this.blindStructure.length + 1;
                const sb = parseInt(document.getElementById('blindSB').value) || 0;
                const bb = parseInt(document.getElementById('blindBB').value) || 0;
                const ante = parseInt(document.getElementById('blindAnte').value) || 0;
                const duration = parseInt(document.getElementById('blindDuration').value) || 15;

                this.blindStructure.push({ sb, bb, ante, duration });
                this.renderBlinds();
                this.saveAllData();
                this.showToast('Nível adicionado!');
            },

            removeBlind(index) {
                this.blindStructure.splice(index, 1);
                this.renderBlinds();
                this.saveAllData();
            },

            saveBlindStructure() {
                this.saveAllData();
                this.showToast('Estrutura de blinds salva!');
            },

            addPrize() {
                const pos = parseInt(document.getElementById('prizePos').value) || this.prizes.length + 1;
                const value = parseFloat(document.getElementById('prizeVal').value) || 0;
                this.prizes.push({ position: pos, value });
                this.renderPrizes();
                this.saveAllData();
                this.showToast('Prêmio adicionado!');
            },

            removePrize(index) {
                this.prizes.splice(index, 1);
                this.renderPrizes();
                this.saveAllData();
            },

            savePrizes() {
                this.saveAllData();
                this.showToast('Premiações salvas!');
            },

            addPlayer() {
                const name = document.getElementById('playerName').value.trim();
                if (!name) { this.showToast('Digite o nome do jogador!'); return; }
                const stack = parseInt(document.getElementById('playerStack').value) || 10000;
                const id = Date.now().toString(36) + Math.random().toString(36).substr(2, 5);
                this.players.push({ id, name, stack, buyin: 1, rebuy: 0, addon: 0 });
                document.getElementById('playerName').value = '';
                this.renderPlayers();
                this.populateDealerSelects();
                this.populateKingSelect();
                this.updateDashboard();
                this.saveAllData();
                this.showToast(`👤 ${name} adicionado!`);
            },

            removePlayer(index) {
                const player = this.players[index];
                if (confirm(`Remover ${player.name}?`)) {
                    this.players.splice(index, 1);
                    this.renderPlayers();
                    this.populateDealerSelects();
                    this.populateKingSelect();
                    this.updateDashboard();
                    this.saveAllData();
                }
            },

            editPlayer(index) {
                const player = this.players[index];
                const newName = prompt('Novo nome:', player.name);
                if (newName && newName.trim()) {
                    player.name = newName.trim();
                    this.renderPlayers();
                    this.populateDealerSelects();
                    this.populateKingSelect();
                    this.saveAllData();
                }
            },

            eliminatePlayer(index) {
                const player = this.players[index];
                if (confirm(`Eliminar ${player.name}?`)) {
                    if (!this.eliminatedPlayers.includes(player.id)) {
                        this.eliminatedPlayers.push(player.id);
                        this.renderPlayers();
                        this.updateDashboard();
                        this.saveAllData();
                        this.showToast(`💀 ${player.name} eliminado!`);
                    }
                }
            },

            restorePlayer(index) {
                const player = this.players[index];
                this.eliminatedPlayers = this.eliminatedPlayers.filter(id => id !== player.id);
                this.renderPlayers();
                this.updateDashboard();
                this.saveAllData();
                this.showToast(`↩️ ${player.name} restaurado!`);
            },

            rebuyPlayer(index) {
                const player = this.players[index];
                if (confirm(`Rebuy para ${player.name}? (R$ ${this.config.rebuyValue.toFixed(2)})`)) {
                    player.stack += this.config.stackRebuy;
                    player.rebuy = (player.rebuy || 0) + 1;
                    this.rebuyCount++;
                    this.renderPlayers();
                    this.updateDashboard();
                    this.saveAllData();
                    this.showToast(`🔄 Rebuy de ${player.name} realizado!`);
                }
            },

            addonPlayer(index) {
                const player = this.players[index];
                if (confirm(`Addon para ${player.name}? (R$ ${this.config.addonValue.toFixed(2)})`)) {
                    player.stack += this.config.stackAddon;
                    player.addon = (player.addon || 0) + 1;
                    this.addonCount++;
                    this.renderPlayers();
                    this.updateDashboard();
                    this.saveAllData();
                    this.showToast(`➕ Addon de ${player.name} realizado!`);
                }
            },

            resetPlayers() {
                if (confirm('Resetar todos os jogadores?')) {
                    this.players = [];
                    this.eliminatedPlayers = [];
                    this.rebuyCount = 0;
                    this.addonCount = 0;
                    this.buyinCount = 0;
                    this.kingPlayerId = null;
                    this.kingHand = '';
                    this.renderPlayers();
                    this.populateDealerSelects();
                    this.populateKingSelect();
                    this.updateDashboard();
                    this.updateKingDisplay();
                    this.saveAllData();
                    this.showToast('Todos os jogadores foram removidos!');
                }
            },

            savePlayers() {
                this.saveAllData();
                this.showToast('Jogadores salvos!');
            },

            populateDealerSelects() {
                const select = document.getElementById('dealerSelect');
                select.innerHTML = '';
                this.players.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.id;
                    opt.textContent = p.name;
                    select.appendChild(opt);
                });
            },

            markDealer() {
                const select = document.getElementById('dealerSelect');
                const id = select.value;
                if (!id) { this.showToast('Selecione um jogador!'); return; }
                this.dealerPlayerId = id;
                this.renderDealer();
                this.saveAllData();
                const player = this.players.find(p => p.id === id);
                this.showToast(`🃏 ${player.name} marcado como Dealer!`);
            },

            drawTables() {
                const numTables = parseInt(document.getElementById('numTables').value) || 2;
                const active = this.players.filter(p => !this.eliminatedPlayers.includes(p.id));
                if (active.length === 0) {
                    this.showToast('Nenhum jogador ativo!');
                    return;
                }

                const shuffled = [...active];
                for (let i = shuffled.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
                }

                const tables = [];
                const perTable = Math.ceil(shuffled.length / numTables);
                for (let i = 0; i < numTables; i++) {
                    const start = i * perTable;
                    const end = Math.min(start + perTable, shuffled.length);
                    tables.push({
                        players: shuffled.slice(start, end).map(p => p.name)
                    });
                }

                this.tables = tables;
                this.renderTables();
                this.saveAllData();
                this.showToast(`🎲 ${numTables} mesas sorteadas!`);
            },

            populatePixSelects() {},

            savePixConfig() {
                this.config.orgPixKey = document.getElementById('pixOrgKey').value;
                this.config.orgPixName = document.getElementById('pixOrgName').value;
                this.config.orgPixCity = document.getElementById('pixOrgCity').value;
                localStorage.setItem('pokerConfig', JSON.stringify(this.config));
                this.showToast('Configurações PIX salvas!');
                this.generatePixQR();
            },

            generatePixQR() {
                const container = document.getElementById('qrcodeContainer');
                container.innerHTML = '';
                const key = this.config.orgPixKey;
                const name = this.config.orgPixName;
                const city = this.config.orgPixCity;
                if (!key) {
                    container.innerHTML = '<p style="color:var(--text2);">Configure a chave PIX primeiro.</p>';
                    return;
                }

                const payload = `00020126330014BR.GOV.BCB.PIX0111${key}5204000053039865802BR5913${name}6008${city}62070503***6304`;
                try {
                    new QRCode(container, {
                        text: payload,
                        width: 200,
                        height: 200,
                        colorDark: '#1a2e1f',
                        colorLight: '#ffffff',
                        correctLevel: QRCode.CorrectLevel.H
                    });
                    this.showToast('QR Code gerado!');
                } catch(e) {
                    container.innerHTML = '<p style="color:var(--danger);">Erro ao gerar QR Code.</p>';
                }
            },

            showToast(msg) {
                const container = document.getElementById('toastContainer');
                const toast = document.createElement('div');
                toast.className = 'toast';
                toast.textContent = msg;
                container.appendChild(toast);
                setTimeout(() => {
                    toast.remove();
                }, 3000);
            }
        };

        document.addEventListener('DOMContentLoaded', () => {
            app.init();
        });

        window.addEventListener('beforeunload', () => {
            if (!app.isDashboardWindow) app.saveAllData();
        });
    </script>
</body>
</html>
